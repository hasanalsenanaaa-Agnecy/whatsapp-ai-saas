# ============================================================
# WhatsApp AI SaaS - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file with real secrets!

# App Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
HOST=0.0.0.0
BASE_URL=http://localhost:3000

# ============================================================
# SECURITY (REQUIRED - Generate secure values!)
# ============================================================

# JWT Secret - MUST be at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE

# Encryption Key - MUST be exactly 64 hex characters (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE

# Admin API Key for administrative endpoints
ADMIN_API_KEY=CHANGE_ME_USE_SECURE_RANDOM_VALUE

# CORS - Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================
# WHATSAPP BUSINESS API (from Meta Developer Console)
# ============================================================
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# ============================================================
# AI SERVICES
# ============================================================

# Anthropic Claude API (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api-your-key-here

# OpenAI API (optional, from platform.openai.com)
OPENAI_API_KEY=sk-your-openai-key-here

# ============================================================
# DATABASE
# ============================================================

# PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_saas

# Or individual settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_saas
DB_USER=postgres
DB_PASSWORD=your_db_password

# ============================================================
# REDIS (Optional - for caching and rate limiting)
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# GOOGLE SHEETS (for lead storage)
# ============================================================
GOOGLE_SHEET_ID=your_spreadsheet_id
GOOGLE_SHEET_NAME=Sheet1

# Option 1: Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json

# Option 2: JSON string of credentials (use for cloud deployments)
# GOOGLE_CREDENTIALS={"type": "service_account", ...}

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_PER_USER=30
RATE_LIMIT_PER_CLIENT=5000

# ============================================================
# BACKUPS
# ============================================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# ============================================================
# BUSINESS INFO (Customizable per client)
# ============================================================
AGENCY_NAME=Your Business Name
AGENT_PHONE_NUMBER=966501234567
