# ============================================================
# WhatsApp AI SaaS - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values

# App Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Business Info
AGENCY_NAME=Your Real Estate Agency
AGENT_PHONE_NUMBER=966501234567

# WhatsApp Business API (from Meta Developer Console)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# Claude AI (from Anthropic Console)
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Google Sheets (for lead storage)
GOOGLE_SHEETS_DISABLED=false
GOOGLE_SHEET_ID=your_spreadsheet_id
GOOGLE_SHEET_NAME=Sheet1
# Either set GOOGLE_CREDENTIALS as JSON string or place google-credentials.json in root
GOOGLE_CREDENTIALS=
GOOGLE_CREDENTIALS_PATH=./google-credentials.json

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname
ENCRYPTION_KEY=replace_with_64_hex_chars
BACKUP_DIR=./backups
BACKUP_PG_DUMP_CMD=/usr/local/bin/pg_dump

# Redis (optional - for production state management)
REDIS_URL=redis://localhost:6379

# Portal
NEXT_PUBLIC_API_URL=http://localhost:3000
