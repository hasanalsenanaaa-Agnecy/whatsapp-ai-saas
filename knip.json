{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/scripts/*.ts",
    "src/cron/*.ts",
    "src/tools/*.ts",
    "src/__tests__/**/*.test.ts"
  ],
  "project": ["src/**/*.ts"],
  "ignore": ["portal/**", "dist/**"],
  "ignoreBinaries": ["tsx"],
  "vitest": false
}
