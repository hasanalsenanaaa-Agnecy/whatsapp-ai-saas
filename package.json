{
  "name": "whatsapp-ai-saas",
  "version": "3.0.0",
  "description": "Production-ready WhatsApp AI SaaS platform",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist --clean --sourcemap",
    "start": "tsx src/index.ts",
    "client": "tsx src/scripts/client-cli.ts",
    "features": "tsx src/scripts/features-cli.ts",
    "export-client": "tsx src/scripts/export-client.ts",
    "sim": "SIM_MODE=1 tsx src/scripts/sim.ts",
    "set-policies": "tsx src/scripts/set-policies.ts",
    "postinstall": "npm run build",
    "db:backup": "tsx src/tools/db-maintenance.ts backup",
    "db:restore": "tsx src/tools/db-maintenance.ts restore",
    "db:pitr": "tsx src/tools/db-maintenance.ts pitr",
    "db:list": "tsx src/tools/db-maintenance.ts list",
    "db:migrate": "tsx src/tools/db-maintenance.ts migrate",
    "db:rollback": "tsx src/tools/db-maintenance.ts rollback",
    "db:rotate-key": "tsx src/tools/db-maintenance.ts rotate-key",
    "ai:smoke": "tsx src/tools/ai-smoke-test.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration"
  },
  "keywords": [
    "whatsapp",
    "ai",
    "saas",
    "chatbot",
    "receptionist"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "@fastify/cors": "^8.5.0",
    "@fastify/rate-limit": "^9.1.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "fastify": "^4.25.2",
    "googleapis": "^171.0.0",
    "postgres": "^3.4.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "happy-dom": "^20.4.0",
    "knip": "^5.35.0",
    "tsup": "^8.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.24.3"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.4"
  }
}
