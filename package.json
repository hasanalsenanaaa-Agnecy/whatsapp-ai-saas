{
  "name": "whatsapp-ai-saas",
  "version": "3.0.0",
  "description": "Production-ready WhatsApp AI SaaS platform",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:backup": "tsx src/tools/db-maintenance.ts backup",
    "db:restore": "tsx src/tools/db-maintenance.ts restore",
    "db:pitr": "tsx src/tools/db-maintenance.ts pitr",
    "db:list": "tsx src/tools/db-maintenance.ts list",
    "db:migrate": "tsx src/tools/db-maintenance.ts migrate",
    "db:rollback": "tsx src/tools/db-maintenance.ts rollback",
    "db:rotate-key": "tsx src/tools/db-maintenance.ts rotate-key",
    "ai:smoke": "tsx src/tools/ai-smoke-test.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration"
  },
  "keywords": [
    "whatsapp",
    "ai",
    "saas",
    "chatbot",
    "receptionist"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "@aws-sdk/client-s3": "^3.520.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.25.2",
    "google-auth-library": "^9.6.3",
    "google-spreadsheet": "^4.1.3",
    "googleapis": "^171.0.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "postgres": "^3.4.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitest/coverage-v8": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "eslint": "^8.56.0",
    "happy-dom": "^12.10.3",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
